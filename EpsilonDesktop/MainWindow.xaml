<Window
    x:Class="EpsilonDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EpsilonDesktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:EpsilonDesktop.Models"
    xmlns:viewModels="clr-namespace:EpsilonDesktop.ViewModels"
    xmlns:views="clr-namespace:EpsilonDesktop.Views"
    Name="windowRoot"
    Title="{Binding Source={x:Static local:Constants.APP_NAME}}"
    Width="Auto"
    Height="Auto"
    MinWidth="300"
    MinHeight="300"
    d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
    Loaded="MainWindow_Load"
    SizeToContent="WidthAndHeight"
    ThemeMode="System"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="400" />
            <ColumnDefinition Width="*" MaxWidth="800" />
        </Grid.ColumnDefinitions>

        <views:FilePickerControl
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            DataContext="{Binding FilePickerViewModel}" />
        <Button
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding SendCodeFileCommand}"
            Content="Send" />

        <Label
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,5,5,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="Code To Send:" />
        <TextBox
            Grid.Row="3"
            Grid.Column="0"
            MaxHeight="200"
            Margin="5,0,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AcceptsReturn="True"
            Text="{Binding CodeToSend}"
            TextWrapping="Wrap" />
        <Button
            Grid.Row="4"
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding SendCodeCommand}"
            Content="Send" />
        <Label
            Grid.Row="5"
            Grid.Column="0"
            Margin="5,5,5,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="Response:" />
        <TextBox
            Grid.Row="6"
            Grid.Column="0"
            MaxHeight="200"
            Margin="5,0,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AcceptsReturn="True"
            Text="{Binding ResponseLog}"
            TextWrapping="Wrap" />
        <ScrollViewer
            Grid.Row="0"
            Grid.RowSpan="7"
            Grid.Column="1"
            Padding="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <ItemsControl ItemsSource="{Binding AxisGraphs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image
                            Margin="5"
                            Source="{Binding}"
                            Stretch="None" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Grid.Row="7"
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding TestCodeCommand}"
            Content="Run Test Code" />
    </Grid>
</Window>

<UserControl 
    x:Class="EpsilonDesktop.Views.MachineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:EpsilonDesktop.Views"
    xmlns:models="clr-namespace:EpsilonDesktop.Models"
    xmlns:viewModels="clr-namespace:EpsilonDesktop.ViewModels"
    xmlns:views="clr-namespace:EpsilonDesktop.Views"
    Name="windowRoot"
    Width="Auto"
    Height="Auto"
    MinWidth="300"
    MinHeight="300"
    d:DataContext="{d:DesignInstance Type=viewModels:MachineViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label
            Content="{Binding CurrentMachine.Name}"
            FontSize="16"
            Grid.Row="0"
            Grid.Column="0"
            Margin="10"/>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="10,0,10,0"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Padding="10,5"
                Background="Firebrick"
                Foreground="White"
                FontWeight="Bold"
                Content="Emergency Stop"
                Command="{Binding EmergencyStopCommand}" />
            <Button
                Margin="0,0,5,0"
                Padding="10,5"
                Content="Pause"
                Command="{Binding PauseCommand}" />
            <Button
                Margin="0,0,5,0"
                Padding="10,5"
                Content="Resume"
                Command="{Binding ResumeCommand}" />
            <Button
                Margin="0,0,10,0"
                Padding="10,5"
                Content="Clear Faults"
                Command="{Binding ClearFaultsCommand}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding Status, StringFormat=Status: {0}}" />
        </StackPanel>

        <views:JogAxesControl
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            DataContext="{Binding JogAxesViewModel}" />

        <views:CurrentPositionControl
            Grid.Row="3"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            DataContext="{Binding CurrentPositionViewModel}" />
    </Grid>
</UserControl>

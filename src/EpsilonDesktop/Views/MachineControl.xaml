<UserControl 
    x:Class="EpsilonDesktop.Views.MachineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:EpsilonDesktop.Views"
    xmlns:models="clr-namespace:EpsilonDesktop.Models"
    xmlns:viewModels="clr-namespace:EpsilonDesktop.ViewModels"
    xmlns:views="clr-namespace:EpsilonDesktop.Views"
    Name="windowRoot"
    Width="Auto"
    Height="Auto"
    MinWidth="300"
    MinHeight="300"
    d:DataContext="{d:DesignInstance Type=viewModels:MachineViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label
            Content="{Binding CurrentMachine.Name}"
            FontSize="16"
            Grid.Row="0"
            Grid.Column="0"
            Margin="10"/>
        
        <views:JogAxesControl
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            DataContext="{Binding JogAxesViewModel}" />
    </Grid>
</UserControl>

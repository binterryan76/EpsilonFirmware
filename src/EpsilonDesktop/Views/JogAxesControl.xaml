<UserControl
    x:Class="EpsilonDesktop.Views.JogAxesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:axis="clr-namespace:EpsilonCore.Motion.Axis;assembly=EpsilonCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EpsilonDesktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:EpsilonDesktop.Models"
    xmlns:viewModels="clr-namespace:EpsilonDesktop.ViewModels"
    x:Name="RootWindow"
    d:DataContext="{d:DesignInstance Type=viewModels:JogAxesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox
            Grid.Row="0"
            Grid.Column="0"
            Width="200"
            Margin="10"
            ItemsSource="{Binding DistancesLinear}"
            SelectedItem="{Binding SelectedDistanceLinear}"
            Visibility="{Binding Axis1Visibility}" />

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Y Up Arrow (↑)  -->
            <Button
                Grid.Row="0"
                Grid.Column="1"
                Width="60"
                Height="60"
                Content="&#x1F819;"
                FontSize="20"
                IsEnabled="{Binding Axis2Enabled}"
                Visibility="{Binding Axis2Visibility}" />

            <!--  X Left Arrow (←)  -->
            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="60"
                Height="60"
                Content="&#x1F818;"
                FontSize="20"
                IsEnabled="{Binding Axis1Enabled}"
                Visibility="{Binding Axis1Visibility}" />

            <!--  X Right Arrow (→)  -->
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Width="60"
                Height="60"
                Content="&#x1F81A;"
                FontSize="20"
                IsEnabled="{Binding Axis1Enabled}"
                Visibility="{Binding Axis1Visibility}" />

            <!--  Y Down Arrow (↓)  -->
            <Button
                Grid.Row="2"
                Grid.Column="1"
                Width="60"
                Height="60"
                Content="&#x1F81B;"
                FontSize="20"
                IsEnabled="{Binding Axis2Enabled}"
                Visibility="{Binding Axis2Visibility}" />

            <!--  Z Up Arrow (↑)  -->
            <Button
                Grid.Row="0"
                Grid.Column="3"
                Width="60"
                Height="60"
                Margin="20,0"
                Content="&#x1F819;"
                FontSize="20"
                IsEnabled="{Binding Axis3Enabled}"
                Visibility="{Binding Axis3Visibility}" />

            <!--  Z Down Arrow (↓)  -->
            <Button
                Grid.Row="2"
                Grid.Column="3"
                Width="60"
                Height="60"
                Margin="20,0"
                Content="&#x1F81B;"
                FontSize="20"
                IsEnabled="{Binding Axis3Enabled}"
                Visibility="{Binding Axis3Visibility}" />

            <Button
                Grid.Row="0"
                Grid.Column="4"
                Margin="20,10,10,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="Home All"
                FontSize="20"
                IsEnabled="{Binding HomeAllEnabled}"
                Visibility="{Binding HomeAllVisibility}" />
            
            <Button
                Grid.Row="1"
                Grid.Column="4"
                Margin="20,10,10,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding Axis1.Name, StringFormat='Home {0}'}"
                FontSize="20"
                IsEnabled="{Binding Axis1Enabled}"
                Visibility="{Binding Axis1Visibility}" />

            <Button
                Grid.Row="2"
                Grid.Column="4"
                Margin="20,10,10,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding Axis2.Name, StringFormat='Home {0}'}"
                FontSize="20"
                IsEnabled="{Binding Axis2Enabled}"
                Visibility="{Binding Axis2Visibility}" />

            <Button
                Grid.Row="3"
                Grid.Column="4"
                Margin="20,10,10,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding Axis3.Name, StringFormat='Home {0}'}"
                FontSize="20"
                IsEnabled="{Binding Axis3Enabled}"
                Visibility="{Binding Axis3Visibility}" />

            <!--  Other Linear Axis Buttons  -->
            <ItemsControl
                Grid.Row="4"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                ItemsSource="{Binding OtherAxesLinear}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:AxisLinearButtonsViewModel">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Negative Direction Arrow (←)  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="60"
                                Height="60"
                                Command="{Binding MoveAxisBackwardLinearCommand, ElementName=RootWindow}"
                                CommandParameter="{Binding Axis}"
                                Content="&#x1F818;"
                                FontSize="20"
                                IsEnabled="{Binding ButtonsEnabled}" />

                            <!--  fake hidden button (this is just to take up space to line up with other buttons  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="60"
                                Height="60"
                                FontSize="20"
                                Visibility="Hidden" />

                            <!--  Positive Direction Arrow (→)  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="60"
                                Height="60"
                                Command="{Binding MoveAxisForwardLinearCommand, ElementName=RootWindow}"
                                CommandParameter="{Binding Axis}"
                                Content="&#x1F81A;"
                                FontSize="20"
                                IsEnabled="{Binding ButtonsEnabled}" />

                            <!--  Home Button  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="20,10,10,10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{Binding Axis.Name, StringFormat='Home {0}'}"
                                FontSize="20"
                                IsEnabled="{Binding ButtonsEnabled}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  Rotational Distance Options  -->
        <ListBox
            Grid.Row="1"
            Grid.Column="0"
            Width="200"
            Margin="10"
            ItemsSource="{Binding DistancesRotational}"
            SelectedItem="{Binding SelectedDistanceRotational}" 
            Visibility="{Binding RotationalDistancesVisibility}" />

        <!--  Rotational Axis Buttons  -->
        <ItemsControl
            Grid.Row="1"
            Grid.Column="1"
            ItemsSource="{Binding AllAxesRotational}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:AxisRotationalButtonsViewModel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Clockwise (Negative) Arrow (↷)  -->
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="60"
                            Height="60"
                            Command="{Binding MoveAxisForwardRotationalCommand, ElementName=RootWindow}"
                            CommandParameter="{Binding Axis}"
                            Content="&#x2B6E;"
                            FontSize="20"
                            IsEnabled="{Binding ButtonsEnabled}" />


                        <!--  fake hidden button (this is just to take up space to line up with other buttons  -->
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="60"
                            Height="60"
                            FontSize="20"
                            Visibility="Hidden" />

                        <!--  Counterclockwise (Positive) Arrow (↶)  -->
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="60"
                            Height="60"
                            Command="{Binding MoveAxisBackwardRotationalCommand, ElementName=RootWindow}"
                            CommandParameter="{Binding Axis}"
                            Content="&#x21B6;"
                            FontSize="20"
                            IsEnabled="{Binding ButtonsEnabled}" />

                        <!--  Home Button  -->
                        <Button
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="20,10,10,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{Binding Axis.Name, StringFormat='Home {0}'}"
                            FontSize="20"
                            IsEnabled="{Binding ButtonsEnabled}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

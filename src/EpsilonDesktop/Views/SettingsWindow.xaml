<Window
    x:Class="EpsilonDesktop.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:EpsilonDesktop.Views"
    xmlns:models="clr-namespace:EpsilonDesktop.Models"
    xmlns:viewModels="clr-namespace:EpsilonDesktop.ViewModels"
    xmlns:views="clr-namespace:EpsilonDesktop.Views"
    Name="windowRoot"
    Title="Settings"
    Width="Auto"
    Height="Auto"
    MinWidth="300"
    d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
    SizeToContent="WidthAndHeight"
    ThemeMode="System"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <views:FilePickerControl
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FileFilter="Scripts (*.cs)|*.cs|All files (*.*)|*.*"
            LabelText="Startup File Path:"
            FilePath="{Binding Settings.StartupFilePath}"/>
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Name="ButtonSave"
                Padding="5"
                Click="ButtonSave_Click"
                Content="Save" 
                Margin="10"/>
            <Button
                Name="ButtonCancel"
                Padding="5"
                Content="Cancel"
                Click="ButtonCancel_Click"
                Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
